# Copy to .env and fill in. .env is gitignored — keep it that way.
#
# API key: https://manage.wix.com/account/api-keys
# Account ID: same page, top right.
# Site ID: run `npm run discover` — it prints the id for every site in the account.

WIX_API_KEY=
WIX_ACCOUNT_ID=
WIX_SITE_ID=

# Public site to crawl for the page copy (step 4).
HVC_SITE_URL=https://www.hvancauteren.be
